# Names only. Copy to .env and fill in. See planning/03-tech-stack.md sections 11 and 13.

# App
APP_ENV=dev
TZ_DEFAULT=Asia/Singapore
LOG_LEVEL=info

# Database
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
TEST_DATABASE_URL=

# Files
STORAGE_DIR=./storage

# URLs
PUBLIC_BASE_URL=
WEB_APP_URL=http://localhost:5173
DOMAIN=

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback
BOSS_EMAIL=

# Sessions
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=14

# Gemini (see planning/decisions.md#D-016)
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-3.5-flash-lite
GEMINI_MODEL_EXTRACT_ESCALATE=
GEMINI_MODEL_REVISE=gemini-3.5-flash-lite
GEMINI_MODEL_EXCEL_MAP=gemini-3.5-flash-lite
GEMINI_MODEL_ASSISTANT=gemini-3.5-flash-lite
GEMINI_MODEL_SALES=gemini-3.5-flash-lite
GEMINI_MODEL_ROUTER=gemini-3.5-flash-lite
GEMINI_MODEL_REPLY=gemini-3.5-flash-lite
GEMINI_MODEL_EMBED=gemini-embedding-2
LLM_TIMEOUT_SECONDS=60

# Tests (never set in production)
E2E_TEST_LOGIN=

# Dev tunnel
NGROK_AUTHTOKEN=
