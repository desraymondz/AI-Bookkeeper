{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.production)",
      "Bash(cat .env*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cat \"/Users/desmond/Documents/Side Projects/AI-Bookkeeper/planning/progress.md\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"/Users/desmond/Documents/Side Projects/AI-Bookkeeper/.claude/hooks/protect.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"/Users/desmond/Documents/Side Projects/AI-Bookkeeper/.claude/hooks/lint-file.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"/Users/desmond/Documents/Side Projects/AI-Bookkeeper/.claude/hooks/quick-check.sh\"", "timeout": 45 }
        ]
      }
    ]
  }
}
